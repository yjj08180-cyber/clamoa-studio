{
  "name": "clamoa-studio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "worker": "tsx --env-file-if-exists=.env.local scripts/worker.ts",
    "check:connections": "tsx --env-file-if-exists=.env.local --env-file-if-exists=.env.setup.local scripts/connections.ts",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:browser": "node scripts/browser-test.mjs"
  },
  "dependencies": {
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "lucide-react": "^0.577.0",
    "sharp": "^0.34.0",
    "fflate": "^0.8.2",
    "unpdf": "^1.0.0",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "playwright": "^1.56.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
