# Copy to .env.setup.local for local management commands.
# Keep management and mail credentials out of the app and worker environments.
SUPABASE_ACCESS_TOKEN=
STUDIO_ADMIN_EMAIL=

# Provide these together to configure custom SMTP, or leave them blank to reuse it.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=CLAMOA Studio
